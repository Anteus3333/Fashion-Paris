# Secrets et config locale (ne jamais committer)
config/*.local.php
config/*.local.*.php
!config/*.local.example.php

# Dépendances PHP
/vendor/*
!/vendor/.htaccess

# Logs locaux
logs/*
!logs/.htaccess

# Docs brouillons locaux
docs/**
!docs/.htaccess
# Notes / captures hors versionnement (explicite)
docs/NoComit/

# Scripts : sync Mongo + protection HTTP
scripts/**
!scripts/.htaccess
!scripts/sync_stats_mongo.php

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
